{
    "name": "armdevstack/sharp-php",
    "description": "SharpPHP: a C#-like language that compiles to modern PHP.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "transpiler",
        "compiler",
        "csharp",
        "language"
    ],
    "homepage": "https://github.com/Narek333888/sharp-php",
    "authors": [
        {
            "name": "Narek",
            "homepage": "https://github.com/Narek333888"
        }
    ],
    "support": {
        "issues": "https://github.com/Narek333888/sharp-php/issues",
        "source": "https://github.com/Narek333888/sharp-php"
    },
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "SharpPhp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SharpPhp\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/sharp"
    ],
    "scripts": {
        "test": [
            "@analyse",
            "phpunit"
        ],
        "analyse": "phpstan analyse --no-progress --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    }
}
