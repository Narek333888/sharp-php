using System;
using System.Collections.Generic;
namespace App;
public class Program
{
    static bool TryGet(int k, out string v) { v = k.ToString(); return k > 0; }
    public static void Main(string[] args)
    {
        int a; if (args.Length > 0) a = 1; else a = 2; Console.WriteLine(a);
        int b; if (args.Length > 0) { b = 1; } else { throw new Exception("x"); } Console.WriteLine(b);
        int c; switch (args.Length) { case 0: c = 0; break; default: c = 9; break; } Console.WriteLine(c);
        string d; TryGet(3, out d); Console.WriteLine(d);
        int e; try { e = 1; } catch (Exception) { e = 2; } Console.WriteLine(e);
        int f; try { Console.Write(""); } finally { f = 5; } Console.WriteLine(f);
        int g; do { g = 7; } while (false); Console.WriteLine(g);
        int h; while (true) { h = 8; break; } Console.WriteLine(h);
        int i; if (args.Length > 0) i = 1; else if (args.Length > 5) i = 2; else i = 3; Console.WriteLine(i);
        int j = 0; j += 1; j++; Console.WriteLine(j);
        string k; var ok = TryGet(1, out k) && k.Length > 0; Console.WriteLine(ok);
        int m; m = 4; Func<int> get = () => m; Console.WriteLine(get());
        int n; for (n = 0; n < 3; n++) { } Console.WriteLine(n);
        Console.WriteLine(nameof(args));
        int p; if (true) { p = 6; } Console.WriteLine(p);
        int q; switch (args.Length) { case var any: q = 1; break; } Console.WriteLine(q);
        int r; try { r = 1; } catch (Exception) { throw; } Console.WriteLine(r);
        int s; { s = 2; } Console.WriteLine(s);
    }
}
