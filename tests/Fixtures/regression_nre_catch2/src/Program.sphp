using System;
public class Foo { public void Run() { Console.WriteLine("run"); } public string Name = "n"; }
public class Program {
    public static void Main() {
        Foo f = null;
        try { f.Run(); } catch (Exception e) { Console.WriteLine("caught2 " + e.GetType().Name + " " + (e is NullReferenceException) + " " + e.Message); }
        try { Console.WriteLine(f.Name); } catch (NullReferenceException e) { Console.WriteLine("caught3 " + e.Message); }
        string s = null;
        try { Console.WriteLine(s.Length); } catch (NullReferenceException e) { Console.WriteLine("caught4 " + e.Message); }
        try { Console.WriteLine(s.ToUpper()); } catch (NullReferenceException e) { Console.WriteLine("caught5 " + e.Message); }
    }
}
