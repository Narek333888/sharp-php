using System;
using System.Collections.Generic;
public class Program {
    static int Parse(string s) => int.Parse(s);
    public static void Main(string[] args) {
        bool c = args.Length == 0;
        int a; if (c) a = 1; else a = 2; Console.WriteLine(a);
        int b; switch (a) { case 1: b = 10; break; default: b = 20; break; } Console.WriteLine(b);
        int d; try { d = Parse("5"); } catch { d = 0; } Console.WriteLine(d);
        var dict = new Dictionary<string,int>();
        int e; if (!dict.TryGetValue("k", out e)) e = -1; Console.WriteLine(e);
        string f; do { f = "x"; } while (f == ""); Console.WriteLine(f);
        int g; if (c) { g = 1; } else { throw new Exception(); } Console.WriteLine(g);
        int h; try { h = Parse("7"); } catch (Exception) { return; } Console.WriteLine(h);
        int i; try { i = 1; } catch { throw; } Console.WriteLine(i);
        int j; for (j = 0; j < 3; j++) { } Console.WriteLine(j);
        int k, l; k = l = 4; Console.WriteLine(k + l);
        object o = 5;
        if (o is not int n) return;
        Console.WriteLine(n);
        if (!(o is int n2)) { return; }
        Console.WriteLine(n2);
        int m; bool ok = int.TryParse("12", out m); Console.WriteLine(m);
        if (!int.TryParse("13", out var p)) return; Console.WriteLine(p);
        int q; try { q = 1; } finally { Console.WriteLine("fin"); } Console.WriteLine(q);
        int r; switch (a) { case 1: r = 1; break; case 2: r = 2; break; default: throw new Exception(); } Console.WriteLine(r);
        int s;
        while (true) { s = 3; break; }
        Console.WriteLine(s);
        int t;
        if (c) { t = 1; } else if (!c) { t = 2; } else { t = 3; }
        Console.WriteLine(t);
        int u;
        if (c && int.TryParse("9", out u)) Console.WriteLine(u);
        string line; int count = 0;
        var lines = new Queue<string>(new[] { "a", "b" });
        while ((line = lines.Count > 0 ? lines.Dequeue() : null) != null) count++;
        Console.WriteLine(count + " " + line);
    }
}
