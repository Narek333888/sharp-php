using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;

public record Person(string First, string Last, int Age);

public class Program
{
    public static void Main()
    {
        // StringBuilder: chained appends, formatting, editing, the indexer and Length.
        var sb = new StringBuilder();
        sb.Append("Total: ").Append(42).Append(' ').Append(true).AppendLine();
        sb.AppendFormat("{0} costs {1:F2}", "tea", 3.5).AppendLine("!");
        sb.Insert(0, ">> ").Replace("tea", "coffee");
        Console.Write(sb.ToString());

        var word = new StringBuilder("Hello", 100);
        word.Append(", world");
        Console.WriteLine(word.Length + " " + word[4] + " " + word.ToString(7, 5));
        word.Length = 5;
        word[0] = 'J';
        Console.WriteLine(word.Remove(1, 1) + "|" + new StringBuilder("x").Clear().Append(1.5) + "|" + new StringBuilder().AppendJoin("-", 1, 2, 3));
        try
        {
            word.Remove(3, 10);
        }
        catch (ArgumentOutOfRangeException)
        {
            Console.WriteLine("Remove past the end: ArgumentOutOfRangeException");
        }

        // ThenBy / ThenByDescending sort the ties of OrderBy further; sorting is stable.
        var people = new List<Person> { new("Ann", "Smith", 30), new("Bob", "Adams", 25), new("Cid", "Smith", 20), new("Al", "Adams", 25) };
        Console.WriteLine(string.Join(" ", people.OrderBy(p => p.Last).ThenBy(p => p.First).Select(p => p.First)));
        Console.WriteLine(string.Join(" ", people.OrderByDescending(p => p.Age).ThenByDescending(p => p.Last).ThenBy(p => p.First).Select(p => p.First)));
        var sorted = new[] { 3, 1, 2 }.OrderBy(x => x);
        Console.WriteLine(string.Join(",", sorted) + " " + sorted.Count + " " + sorted.ToList()[0]);

        // Zip pairs elements up to the shorter sequence; the result type comes from the lambda.
        var names = new[] { "Ann", "Bob", "Cid" };
        var ages = new List<int> { 30, 25 };
        var pairs = names.Zip(ages, (n, a) => n + ":" + a);
        Console.WriteLine(string.Join(" ", pairs) + " " + pairs[0].Length);

        // StringComparison
        Console.WriteLine("Hello".Equals("hello", StringComparison.OrdinalIgnoreCase) + " " + string.Equals("a", "A", StringComparison.Ordinal) + " " + "a".Equals("a"));
        Console.WriteLine("Hello World".Contains("WORLD", StringComparison.OrdinalIgnoreCase) + " " + "Hello".StartsWith("he", StringComparison.CurrentCultureIgnoreCase) + " " + "Hello".EndsWith("LO", StringComparison.OrdinalIgnoreCase) + " " + "Hello".StartsWith("he"));
        Console.WriteLine("Hello".IndexOf("L", StringComparison.OrdinalIgnoreCase) + " " + "Hello".IndexOf("l", 3) + " " + "Hello".IndexOf("L") + " " + "Hello".LastIndexOf("L", StringComparison.OrdinalIgnoreCase));
        Console.WriteLine("Cat cat CAT".Replace("cat", "dog", StringComparison.OrdinalIgnoreCase) + " | " + "Cat cat".Replace("cat", "$1"));
        Console.WriteLine(Math.Sign(string.Compare("a", "B", StringComparison.OrdinalIgnoreCase)) + " " + Math.Sign(string.Compare("a", "B", StringComparison.Ordinal)) + " " + string.Compare("a", "A", true));
        Console.WriteLine(StringComparison.Ordinal + " " + (int)StringComparison.OrdinalIgnoreCase);
    }
}
