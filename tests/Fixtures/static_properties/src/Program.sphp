namespace App;
public static class Config
{
    private static int _level = 1;
    private static readonly List<string> _log = new();
    public static int Level
    {
        get => _level;
        set
        {
            if (value < 0) throw new ArgumentOutOfRangeException(nameof(value));
            _level = value;
            _log.Add($"level={value}");
        }
    }
    public static int LogCount => _log.Count;
    public static string Mode { get { return _level > 2 ? "verbose" : "quiet"; } }
    public static double Ratio { get; set; } = 0.5;
    public static void Bump() { Level++; }
}
public class Program
{
    public static void Main()
    {
        Console.WriteLine(Config.Level + " " + Config.Mode + " " + Config.LogCount);
        Config.Level = 3;
        Config.Level += 2;
        Config.Bump();
        Console.WriteLine($"{Config.Level} {Config.Mode} {Config.LogCount}");
        var old = Config.Level++;
        var now = ++Config.Level;
        var assigned = Config.Level = 10;
        Console.WriteLine($"{old} {now} {assigned} {Config.Level}");
        try { Config.Level = -1; } catch (ArgumentOutOfRangeException) { Console.WriteLine("rejected"); }
        Config.Ratio = 0.75; Console.WriteLine(Config.Ratio);
    }
}
