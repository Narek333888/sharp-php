using System;
using System.Collections.Generic;
public class Bag {
    public IEnumerable<int> Items { get { yield return 1; yield return 2; } }
    public static IEnumerable<string> Names { get { yield return "a"; } }
}
public class Program {
    public static void Main() { foreach (var i in new Bag().Items) Console.WriteLine(i); foreach (var n in Bag.Names) Console.WriteLine(n); }
}
