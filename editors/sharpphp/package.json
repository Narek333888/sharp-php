{
    "name": "sharpphp",
    "displayName": "SharpPHP",
    "description": "SharpPHP (.sphp), a C#-like language that compiles to PHP: highlighting, completion, parameter info, errors while typing, hover and go to definition",
    "version": "0.8.0",
    "publisher": "armdevstack",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Narek333888/sharp-php"
    },
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:sharpphp",
        "workspaceContains:**/*.sphp"
    ],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "In Restricted Mode only highlighting works: the language server runs PHP code of the project (vendor/bin/sharp).",
            "restrictedConfigurations": [
                "sharpphp.php.path",
                "sharpphp.server.path"
            ]
        }
    },
    "contributes": {
        "languages": [
            {
                "id": "sharpphp",
                "aliases": [
                    "SharpPHP",
                    "sharpphp"
                ],
                "extensions": [
                    ".sphp"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "sharpphp",
                "scopeName": "source.sharpphp",
                "path": "./syntaxes/sharpphp.tmLanguage.json"
            }
        ],
        "commands": [
            {
                "command": "sharpphp.restartServer",
                "title": "Restart Language Server",
                "category": "SharpPHP"
            }
        ],
        "configuration": {
            "title": "SharpPHP",
            "properties": {
                "sharpphp.php.path": {
                    "type": "string",
                    "default": "php",
                    "scope": "machine-overridable",
                    "markdownDescription": "PHP executable (8.4 or newer) that runs the SharpPHP language server. Use the full path, e.g. `/opt/homebrew/bin/php` (`which php` in a terminal prints it), when VS Code does not find PHP."
                },
                "sharpphp.server.path": {
                    "type": "string",
                    "default": "",
                    "scope": "resource",
                    "markdownDescription": "The `sharp` command of SharpPHP, started as `php <path> lsp`. Empty: `${workspaceFolder}/vendor/bin/sharp`. A relative path is relative to the workspace folder; `${workspaceFolder}` may be used."
                }
            }
        }
    }
}
